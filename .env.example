# 邻鲜履约平台 - 本地环境变量模板
# 用法：复制本文件为 .env，并填入你自己的值。
# .env 已被 .gitignore 忽略，不会提交到公开仓库；docker compose 会自动读取它。
# IDE / 命令行运行各服务时，也请把这些变量设置到运行环境（见 README「快速启动」）。

# MySQL root 密码（容器初始化 + 应用连接共用）
MYSQL_ROOT_PASSWORD=

# RabbitMQ 密码（用户名固定为 guest）
RABBITMQ_DEFAULT_PASS=

# JWT 签名密钥（任意长度 >=32 字节的随机字符串）
JWT_SECRET=
